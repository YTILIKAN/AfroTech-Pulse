# Copier ce fichier en .env puis renseigner chaque valeur.
# Le fichier .env est ignore par Git et ne doit jamais etre commite.

# --- LLM (obligatoire) ---
# Cle API Google Gemini — resumes, selection editoriale, redaction newsletter.
# A obtenir sur aistudio.google.com (gratuit, sans carte bancaire).
GEMINI_API_KEY=

# --- Telegram (obligatoire — canal de publication actif) ---
# Token du bot qui publie sur le canal. A creer via @BotFather.
TELEGRAM_BOT_TOKEN=
# Identifiant du canal PUBLIC ou la newsletter est publiee (ex. @ytilikan).
TELEGRAM_CHANNEL_ID=
# Identifiant du groupe PRIVE de l'equipe (rappels de validation, alertes d'echec).
# Jamais visible des abonnes.
TELEGRAM_ADMIN_CHAT_ID=

# --- Hebergement (Railway) ---
# Chemin de la base SQLite. En local : laisser vide (afrotech.db a la racine).
# Sur Railway : chemin du volume monte, ex. /data/afrotech.db
# DB_PATH=/data/afrotech.db
# Mot de passe de la page Validation (modifie la base). Obligatoire une fois en ligne ;
# non defini en local (aucun controle).
# VALIDATION_PASSWORD=
# Mettre a 1 pour lancer l'app sans le planificateur (dev local, second replica).
# DISABLE_SCHEDULER=1

# --- Email via Resend (optionnel — canal en evolution, desactive) ---
# Laisser vide tant que la liste d'abonnes et le domaine d'envoi ne sont pas prets.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
